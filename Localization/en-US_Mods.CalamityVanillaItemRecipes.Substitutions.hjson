CalamityDisableItem: "[c/{$Colours.CalamityRed}:(You should probably disable the added items if you're playing with Calamity enabled)]"
CalamityDisableRecipe: "[c/{$Colours.CalamityRed}:(You should probably disable all current recipes if you're playing with Calamity enabled)]"
