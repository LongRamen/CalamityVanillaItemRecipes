Removed_2_1_0: "[c/{$Colours.Removed}:(Recipe removed in Calamity v2.1.0)]"
ItemsTooltip:
	'''
	Turning this off disables all methods of obtaining this item, but it does not unload the item
	from the game, so any items that are already in the inventory or a chest will stay there.

	{$CalamityDisableItem}
	'''
DeprecatedTooltip:
	'''
	[c/{$Colours.Deprecated}:This item is now deprecated and is unobtainable and unusable.]
	[c/{$Colours.Deprecated}:Any remaining can be sold for their original sell price.]
	'''

