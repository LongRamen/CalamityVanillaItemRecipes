Configs: {
	MainConfig: {
		DisplayName: Server Config
		DisableIfCalamity: "[c/FF0000:(You should probably disable this if you're playing with Calamity enabled)]"
		ItemsTooltip:
			'''
			See "Exceptions" in the mod description for more details on this feature.

			Note: turning these options off disables all methods of obtaining the added
			items and all the recipes that include them, but it does not completely
			unload the items from the game, so any of these items that are already in
			the inventory or a chest will stay there.

			{$DisableIfCalamity}

			'''

		Headers: {
			General: General
			EnableItems: Add Calamity crafting materials
			AncientBoneDust: Ancient Bone Dust Header
			BloodOrb: Blood Orb Header
			EssenceOfEleum: Essence Of Eleum Header
			BloodOrbPotions: Blood Orb Potions Header
		}

		AddCurrentRecipes: {
			Label: Add Current Recipes
			Tooltip:
				'''
				Adds the vanilla item recipes added by the current version of Calamity.
				Use this if you're doing a vanilla+ playthrough and want these recipes.

				{$DisableIfCalamity}

				'''
		}

		AddRemovedRecipes: {
			Label: Add Removed Recipes
			Tooltip:
				'''
				Adds the vanilla item recipes that were removed in Calamity version 2.1.

				'''
